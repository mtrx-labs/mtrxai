{
  "version": 2,
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug with tests and sanitizers",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/cmake-build-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "MTRXAI_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "environment": { "ASAN_OPTIONS": "detect_leaks=0" },
      "output": { "outputOnFailure": true }
    }
  ]
}
