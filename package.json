{
  "name": "mtrxai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run --cwd packages/cli src/index.ts",
    "build": "bun run --cwd packages/cli build",
    "typecheck": "bun run --cwd packages/core typecheck && bun run --cwd packages/tui typecheck && bun run --cwd packages/cli typecheck",
    "test": "bun test packages/core/test"
  },
  "devDependencies": {
    "@opentui/core-linux-x64-musl": "0.7.0",
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "typescript": "6.0.2"
  }
}
